{
  "name": "ion-athens",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*", "tools/*"],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build:graph": "npm run build --workspace @ion/build-graph",
    "server": "npm run dev --workspace @ion/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
