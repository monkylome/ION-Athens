# Optional. Copy to .env in the repository root for sandbox-backed features.
# The API key stays on the server. Do not prefix it with VITE_.
SANDBOX=https://athensgov.cityofathens.gr/sandbox
SANDBOX_KEY=

# Optional server overrides. Relative paths resolve from apps/server.
# PORT=8787
# ION_GRAPH_PATH=../../data/athens-centre.graph.json
# ION_ENRICHMENT_PATH=../../data-local/athens-centre.enrichment.json
# ION_ROUTING=fallback
# ION_POLL_MS=5000
# ION_REPORT_TTL_HOURS=12
# ION_CORS_ORIGINS=http://localhost:5173
# ION_DEMO=off
# ION_LLM=off
# ION_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Camera scan (apps/server/src/vision). A local vision model behind Ollama; scripts/vision-start starts it.
# Without both, /api/vision/* answers 503 and the rest of the server is unaffected.
# VISION_URL=http://127.0.0.1:11435
# VISION_MODEL=qwen3-vl:4b-instruct
# VISION_LICENCE=Apache-2.0   # only for a model the server does not know
