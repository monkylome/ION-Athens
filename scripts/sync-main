#!/usr/bin/env bash
set -euo pipefail

export ION_SYNC_IN_PROGRESS=1

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

if [[ "$(git symbolic-ref --quiet --short HEAD || true)" != main ]]; then
    echo "Switch to main before syncing." >&2
    exit 1
fi

if git rev-parse --verify --quiet MERGE_HEAD >/dev/null; then
    echo "Finish the in-progress merge and commit it before syncing." >&2
    exit 1
fi

# Uncommitted changes to tracked files only matter when a merge is needed.
# Several agents can work in one tree, so a push of finished commits must not
# wait for someone else's unfinished edits.
dirty=$(git status --porcelain --untracked-files=no)

for attempt in 1 2 3; do
    git fetch origin refs/heads/main
    remote_head=$(git rev-parse FETCH_HEAD)

    if [[ -n "$dirty" ]] && ! git merge-base --is-ancestor "$remote_head" HEAD; then
        echo "origin/main has new commits and tracked files have uncommitted changes:" >&2
        echo "$dirty" >&2
        echo "Commit or set aside those changes, then rerun scripts/sync-main." >&2
        exit 1
    fi

    if ! git merge --no-edit "$remote_head"; then
        echo "Inspect git status. Resolve any conflicts, verify, commit the merge, and rerun scripts/sync-main." >&2
        exit 1
    fi

    if [[ "$(git rev-parse HEAD)" != "$remote_head" ]]; then
        if ! scripts/check-commit --tree; then
            echo "Not pushed. Fix the conflict markers, commit, and rerun scripts/sync-main." >&2
            exit 1
        fi
        if ! timeout 60 ${ION_CHECK_CMD:-scripts/check}; then
            echo "Not pushed: scripts/check failed or took over 60 seconds. Your commits are local. Fix, commit, and rerun scripts/sync-main." >&2
            exit 1
        fi
    fi

    if git push origin HEAD:refs/heads/main; then
        exit 0
    fi

    # Retry when a teammate published another commit during this attempt.
    git fetch origin refs/heads/main
    if git merge-base --is-ancestor FETCH_HEAD HEAD; then
        echo "Push failed. Check the Git error above." >&2
        exit 1
    fi
done

echo "origin/main kept advancing. Run scripts/sync-main again." >&2
exit 1
