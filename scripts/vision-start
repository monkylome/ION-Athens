#!/bin/sh
# Starts the local vision model server (Ollama, user space) on 127.0.0.1:11435.
# Safe to run twice: if our own process is already running, it only reports it.
# Everything lives under data-local/vision/ (gitignored). Frames never leave this machine.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
V="$ROOT/data-local/vision"
PIDFILE="$V/run/ollama.pid"
HOSTPORT="${VISION_HOST:-127.0.0.1:11435}"
MODEL="${VISION_MODEL:-qwen3-vl:4b-instruct}"
[ -x "$V/bin/ollama" ] || { echo "Missing $V/bin/ollama (see apps/server/README.md, section Vision)." >&2; exit 1; }
mkdir -p "$V/run" "$V/models"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  echo "vision: already running (pid $(cat "$PIDFILE")) on $HOSTPORT"
else
  OLLAMA_MODELS="$V/models" OLLAMA_HOST="$HOSTPORT" OLLAMA_KEEP_ALIVE=30m OLLAMA_NUM_PARALLEL=1 \
    nohup "$V/bin/ollama" serve >"$V/run/ollama.log" 2>&1 &
  echo $! >"$PIDFILE"
  echo "vision: started pid $(cat "$PIDFILE") on $HOSTPORT"
fi
i=0
until curl -fsS "http://$HOSTPORT/api/version" >/dev/null 2>&1; do
  i=$((i + 1)); [ "$i" -gt 40 ] && { echo "vision: server did not answer; see $V/run/ollama.log" >&2; exit 1; }
  sleep 0.5
done
if [ "${1:-}" = "--pull" ]; then OLLAMA_HOST="$HOSTPORT" OLLAMA_MODELS="$V/models" "$V/bin/ollama" pull "$MODEL"; fi
echo "vision: ready. Set VISION_URL=http://$HOSTPORT VISION_MODEL=$MODEL for the server."
